# ==============================================================================
# SmartMES Environment Variables Template
# Copy this file to .env before running the application locally or via Docker
# ==============================================================================

# General Application Settings
PROJECT_NAME="SmartMES"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_USER=smartmes
POSTGRES_PASSWORD=smartmes_secret_pass
POSTGRES_DB=smartmes_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://smartmes:smartmes_secret_pass@postgres:5432/smartmes_db

# Cache & Message Broker Configuration (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL=redis://redis:6379/0

# Security & Authentication Configuration
JWT_SECRET=super_secret_smartmes_jwt_key_change_in_production_32bytes_minimum!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Frontend Next.js Public Settings
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="SmartMES"
